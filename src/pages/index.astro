---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === 'Articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const canonical = new URL(base, Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Les Petits Bugs', url: canonical, inLanguage: 'fr-FR' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Les Petits Bugs', url: canonical }
];
---
<BaseLayout title="Les petits bugs | Parentalité sans mode d’emploi" description="Un petit journal parental pour comprendre les grandes émotions, poser des limites et trouver des idées concrètes pour le quotidien." canonical={canonical} image="/logos/logo-full-clean.png" jsonLd={jsonLd} bodyClass="home-page" activeSection="home">
    <div id="search-panel"><div class="wrap"><label for="search-input" class="sr-only">Rechercher un article</label><input type="search" id="search-input" placeholder="Chercher un article : émotion, limite, jeu…" /><p id="search-empty" class="search-empty" hidden>Aucun article ne correspond à cette recherche.</p></div></div>
    <section class="magazine" id="articles">
      <div class="wrap">
        <div class="section-head"><div><p class="section-kicker">À lire maintenant</p><h2>Nos articles</h2></div><span class="article-count" id="article-count">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</span></div>
        <div class="mag-grid" id="card-grid">
          {articles.map((article, i) => <ArticleCard article={article} featured={i === 0} />)}
        </div>
      </div>
    </section>
    <section class="try-today"><div class="wrap"><div class="try-box"><div><span class="try-label">Une idée à tester aujourd’hui</span><h2>Quand parler est difficile, essayez d’écrire.</h2><p>« Tu n’as pas besoin de m’expliquer maintenant. Je peux l’écrire pour toi. »</p></div><a href={`${base}article-ecrire-emotions.html`} class="text-link">Lire l’article →</a></div></div></section>
    <NewsletterSignup />
    <script is:inline>
      function toggleSearch() { const panel = document.getElementById('search-panel'); const input = document.getElementById('search-input'); if (!panel) return; panel.classList.toggle('open'); if (panel.classList.contains('open')) input?.focus(); }
      function filterCards(query) { const q = query.trim().toLowerCase(); const cards = document.querySelectorAll('#card-grid .card'); let visible = 0; cards.forEach((card) => { const match = `${card.dataset.search || ''} ${card.textContent}`.toLowerCase().includes(q); card.style.display = match ? '' : 'none'; if (match) visible++; }); const empty = document.getElementById('search-empty'); if (empty) empty.hidden = visible !== 0 || q === ''; const count = document.getElementById('article-count'); if (count) count.textContent = q ? `${visible} ${visible === 1 ? 'article' : 'articles'}` : `${cards.length} articles`; }
      document.getElementById('search-input')?.addEventListener('input', (event) => filterCards(event.target.value));
      if (new URLSearchParams(window.location.search).has('recherche')) toggleSearch();
    </script>
</BaseLayout>
