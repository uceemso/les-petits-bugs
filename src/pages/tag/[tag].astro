---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { tagDefinitions } from '../../lib/tags';

export async function getStaticPaths() {
  return tagDefinitions.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const contents = (await getCollection('articles', ({ data }) => !data.draft && data.tags.includes(tag.value))).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const canonical = new URL(`${base}tag/${tag.slug}.html`, Astro.site).href;
---
<BaseLayout title={`${tag.label} | Les Petits Bugs`} description={`Tous les contenus des Petits Bugs autour du thème ${tag.label.toLowerCase()}.`} canonical={canonical} activeSection="articles">
  <section class="listing-page">
    <div class="wrap">
      <div class="page-header">
        <p class="section-kicker">Thème</p>
        <h1>{tag.label}</h1>
        <p class="page-intro">Tous les contenus associés à ce thème, qu’il s’agisse d’un article ou d’une ressource.</p>
        <nav class="tag-filter" aria-label="Voir un autre thème">
          <a href={`${base}articles.html`} class="tag-pill">Tous les articles</a>
          {tagDefinitions.filter((item) => item.slug !== tag.slug).map((item) => <a href={`${base}tag/${item.slug}.html`} class="tag-pill">{item.label}</a>)}
        </nav>
      </div>
      <div class="section-head"><h2>À lire</h2><span class="article-count">{contents.length} {contents.length === 1 ? 'contenu' : 'contenus'}</span></div>
      <div class="mag-grid">
        {contents.map((article, i) => <ArticleCard article={article} featured={i === 0} />)}
      </div>
    </div>
  </section>
</BaseLayout>
