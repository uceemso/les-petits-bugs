---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getTagDefinition } from '../lib/tags';

interface Props { article: CollectionEntry<'articles'>; related: CollectionEntry<'articles'>[]; }
const { article, related } = Astro.props;
const { data } = article;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { Content } = await render(article);
const isResource = data.category === 'Livres & ressources';
const backHref = isResource ? `${base}livres-ressources.html` : `${base}articles.html`;
const backLabel = isResource ? '← Retour aux livres & ressources' : '← Retour aux articles';
---
<article class="article">
  <div class="article-hero wrap">
    <div class="photo-wrap"><img src={`${base}${data.image.replace(/^\//, '')}`} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} fetchpriority="high" /></div>
  </div>
  <div class="article-head wrap">
    <a href={backHref} class="back">{backLabel}</a>
    <span class="cat">{data.category}</span>
    <h1>{data.title}</h1>
    <p class="lede">{data.description}</p>
    <div class="tag-list article-tags" aria-label="Thèmes de l’article">
      {data.tags.map((tag) => {
        const definition = getTagDefinition(tag);
        return definition && <a href={`${base}tag/${definition.slug}.html`} class="tag-pill">{definition.label}</a>;
      })}
    </div>
    <p class="meta-line">Par <a href={`${base}a-propos.html`} class="author-link">Marie</a> · <time datetime={data.date.toISOString().slice(0, 10)}>{data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time> · {data.readingTime}</p>
  </div>
  <div class="article-body"><Content /></div>
  <NewsletterSignup />
  {related.length > 0 && <section class="related">
    <div class="wrap"><h2>À lire aussi</h2><div class="mag-grid">
      {related.map((item) => <ArticleCard article={item} />)}
    </div></div>
  </section>}
</article>
