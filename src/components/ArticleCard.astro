---
import type { CollectionEntry } from 'astro:content';

interface Props { article: CollectionEntry<'articles'>; featured?: boolean; }
const { article, featured = false } = Astro.props;
const { data } = article;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = `${base}${data.slug}.html`;
const search = `${data.title} ${data.description} ${data.category}`.toLowerCase();
---
<a href={href} class:list={["card", { featured }]} data-search={search}>
  <div class="inner">
    <div class="photo-wrap">
      <img src={`${base}${data.image.replace(/^\//, '')}`} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} loading={featured ? 'eager' : 'lazy'} />
    </div>
    <div>
      <div class="card-meta">
        <span class="cat">{data.category}</span>
        <time class="date" datetime={data.date.toISOString().slice(0, 10)}>{data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
      </div>
      <h3>{data.title}</h3>
      <p class="excerpt">{data.description}</p>
    </div>
  </div>
</a>
